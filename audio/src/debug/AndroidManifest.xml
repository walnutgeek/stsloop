<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: Bluetooth test mode (#27), which release builds refuse to run
     (SessionService.testModeAllowed). Merged into the debug variant's manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The car's hands-free mic via setCommunicationDevice, and the in_communication audio mode. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Test mode speaks through the system TextToSpeech engine (package visibility, API 30+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
