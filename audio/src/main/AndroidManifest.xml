<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Bluetooth test mode's permissions live in src/debug/AndroidManifest.xml only. -->

    <application>
        <!-- A Session. Typed `microphone` (a while-in-use type), never shortService.
             shortService is declared only for the moment a refused Start must
             still call startForeground() before stopping; no Session runs as it. -->
        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="microphone|shortService" />
    </application>
</manifest>
